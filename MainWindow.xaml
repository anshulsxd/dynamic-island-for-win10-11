<Window x:Class="IslandEye.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island" Width="290" Height="60"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2B2B2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#434347"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#5A5A60"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- text-only tab; the animated underline is drawn separately -->
        <Style x:Key="Tab" TargetType="Button">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,6"/>
            <Setter Property="Margin" Value="21,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2B2B2E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="100">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- big toggle tile (Wi-Fi / Bluetooth / Airplane) -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Background" Value="#2B2B2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="20" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InstallBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#30D158"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- [ear] [island] [ear] : the ears only show in Notch mode -->
    <Grid x:Name="IslandHost" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Path x:Name="EarL" Grid.Column="0" Data="M 0,0 L 10,0 L 10,10 A 10,10 0 0 0 0,0 Z" Fill="Black"
              Width="10" Height="10" VerticalAlignment="Top" Visibility="Collapsed"/>
        <Path x:Name="EarR" Grid.Column="2" Data="M 0,0 L 10,0 A 10,10 0 0 0 0,10 Z" Fill="Black"
              Width="10" Height="10" VerticalAlignment="Top" Visibility="Collapsed"/>

        <Border x:Name="Island" Grid.Column="1" Background="Black" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="18"
                Width="250" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,6,0,0" ClipToBounds="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== Collapsed header: weather text | temperature + icon ===== -->
                <Grid x:Name="CollapsedHeader" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WCondition" Text="Loading…" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="WTempSmall" Text="" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WIconSmall" Text="&#x1F4CD;" FontFamily="Segoe UI Emoji" FontSize="17" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Expanded header: clock | weather | battery ring ===== -->
                <Grid x:Name="ExpandedHeader" Grid.Row="0" Opacity="0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ClockText" Grid.Column="0" Text="12:00" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderIcon" Text="" FontFamily="Segoe UI Emoji" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="HeaderTemp" Text="" Foreground="#D1D1D6" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid x:Name="BatteryRing" Grid.Column="2" Width="24" Height="24"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Ellipse Stroke="#3A3A3C" StrokeThickness="2.5"/>
                        <Ellipse x:Name="BatteryArc" Stroke="#30D158" StrokeThickness="2.5"
                                 StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="BatteryText" Text="100" FontSize="8" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- ===== Expanded content ===== -->
                <!-- fixed size => nothing inside re-lays-out while the island grows/shrinks -->
                <Grid x:Name="Body" Grid.Row="1" Width="640" Height="288" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- tabs with a bouncing underline -->
                    <Grid x:Name="TabStrip" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12" SizeChanged="TabStrip_SizeChanged">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Button x:Name="TabMusic"    Style="{StaticResource Tab}" Content="Music"      Click="Tab_Click" Tag="Music"/>
                            <Button x:Name="TabControls" Style="{StaticResource Tab}" Content="Controls"   Click="Tab_Click" Tag="Controls"/>
                            <Button x:Name="TabCalc"     Style="{StaticResource Tab}" Content="Calculator" Click="Tab_Click" Tag="Calc"/>
                            <Button x:Name="TabCalendar" Style="{StaticResource Tab}" Content="Calendar"   Click="Tab_Click" Tag="Calendar"/>
                            <Button x:Name="TabWeather"  Style="{StaticResource Tab}" Content="Weather"    Click="Tab_Click" Tag="Weather"/>
                            <Button x:Name="TabAlerts"   Style="{StaticResource Tab}" Content="Alerts"     Click="Tab_Click" Tag="Alerts"/>
                            <Button x:Name="TabVersion"  Style="{StaticResource Tab}" Content="Version"    Click="Tab_Click" Tag="Version"/>
                        </StackPanel>
                        <Border x:Name="TabUnderline" Height="3" CornerRadius="1.5" Background="White"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="0">
                            <Border.RenderTransform><TranslateTransform x:Name="UlT"/></Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- MUSIC -->
                    <Grid x:Name="MusicPanel" Grid.Row="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="10" Background="#222" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="&#x266B;" FontSize="24" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="Cover" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SongTitle" Text="Nothing playing" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SongArtist" Text="Open Spotify and hit play" Foreground="#8E8E93" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,14,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" MinWidth="30"/>
                            <Grid x:Name="TrackHit" Grid.Column="1" Height="16" Margin="8,0" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="Track_Down" MouseMove="Track_Move" MouseLeftButtonUp="Track_Up"
                                  MouseEnter="Track_Enter" MouseLeave="Track_Leave" VerticalAlignment="Center">
                                <Border Height="4" CornerRadius="2" Background="#3A3A3C"/>
                                <Border x:Name="TrackFill" Height="4" CornerRadius="2" Background="White" HorizontalAlignment="Left" Width="0"/>
                                <Ellipse x:Name="TrackDot" Width="12" Height="12" Fill="White" HorizontalAlignment="Left"
                                         VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"/>
                            </Grid>
                            <TextBlock x:Name="RemainText" Grid.Column="2" Text="-0:00" Foreground="#8E8E93" FontSize="11"
                                       VerticalAlignment="Center" TextAlignment="Right" MinWidth="34"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource Pill}" Background="Transparent" Width="56" Height="40" Margin="0,0,14,0"
                                    Click="Prev_Click" FontFamily="Segoe MDL2 Assets" FontSize="18" Content="&#xE892;"/>
                            <Button x:Name="PlayBtn" Style="{StaticResource Pill}" Width="64" Height="40"
                                    Click="Play_Click" FontFamily="Segoe MDL2 Assets" FontSize="20" Content="&#xE768;"/>
                            <Button Style="{StaticResource Pill}" Background="Transparent" Width="56" Height="40" Margin="14,0,0,0"
                                    Click="Next_Click" FontFamily="Segoe MDL2 Assets" FontSize="18" Content="&#xE893;"/>
                        </StackPanel>
                    </Grid>

                    <!-- CONTROLS: Wi-Fi / Bluetooth / Airplane + vertical volume & brightness -->
                    <Grid x:Name="ControlsPanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,30,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="WifiTile" Grid.Column="0" Style="{StaticResource Tile}" Height="86" Margin="0,0,8,0" Click="Wifi_Click">
                                    <StackPanel>
                                        <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"/>
                                        <TextBlock Text="Wi-Fi" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="WifiStatus" Text="…" FontSize="11" Foreground="#8E8E93"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtTile" Grid.Column="1" Style="{StaticResource Tile}" Height="86" Margin="4,0" Click="Bt_Click">
                                    <StackPanel>
                                        <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"/>
                                        <TextBlock Text="Bluetooth" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="BtStatus" Text="…" FontSize="11" Foreground="#8E8E93"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AirTile" Grid.Column="2" Style="{StaticResource Tile}" Height="86" Margin="8,0,0,0" Click="Air_Click">
                                    <StackPanel>
                                        <TextBlock Text="&#x2708;" FontFamily="Segoe UI Symbol" FontSize="20" Foreground="White"/>
                                        <TextBlock Text="Airplane" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="AirStatus" Text="…" FontSize="11" Foreground="#8E8E93"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Margin="0,12,0,0" Background="#141416" CornerRadius="20" Padding="14,10">
                                <StackPanel>
                                    <TextBlock x:Name="VolDevice" Text="" Foreground="#8E8E93" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="MuteBtn" Style="{StaticResource CircleBtn}" Width="34" Height="34" Margin="0,0,10,0"
                                                FontFamily="Segoe MDL2 Assets" FontSize="14" Content="&#xE767;" Click="Mute_Click"/>
                                        <Button Style="{StaticResource Pill}" Content="25%"  Tag="25"  Width="54" Height="34" Margin="3,0" Click="VolChip_Click"/>
                                        <Button Style="{StaticResource Pill}" Content="50%"  Tag="50"  Width="54" Height="34" Margin="3,0" Click="VolChip_Click"/>
                                        <Button Style="{StaticResource Pill}" Content="75%"  Tag="75"  Width="54" Height="34" Margin="3,0" Click="VolChip_Click"/>
                                        <Button Style="{StaticResource Pill}" Content="100%" Tag="100" Width="54" Height="34" Margin="3,0" Click="VolChip_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- vertical bars on the right -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel>
                                <Grid x:Name="VolTrack" Width="58" Height="168" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="VolTrack_Down" MouseMove="VolTrack_Move" MouseLeftButtonUp="VolTrack_Up">
                                    <Border CornerRadius="29" Background="#1C1C1E"/>
                                    <Border x:Name="VolFill" CornerRadius="29" VerticalAlignment="Bottom" Height="0"/>
                                    <TextBlock x:Name="VolIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock x:Name="VolPercent" Text="50%" Foreground="#8E8E93" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="BrightPanel" Margin="16,0,0,0" Visibility="Collapsed">
                                <Grid x:Name="BrightTrack" Width="58" Height="168" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="BrightTrack_Down" MouseMove="BrightTrack_Move" MouseLeftButtonUp="BrightTrack_Up">
                                    <Border CornerRadius="29" Background="#1C1C1E"/>
                                    <Border x:Name="BrightFill" CornerRadius="29" VerticalAlignment="Bottom" Height="0"/>
                                    <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock x:Name="BrightPercent" Text="50%" Foreground="#8E8E93" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- CALCULATOR -->
                    <Grid x:Name="CalcPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#1C1C1E" CornerRadius="8" Margin="2,0,2,4">
                            <TextBlock x:Name="CalcDisplay" Text="0" Foreground="White" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </Border>
                        <UniformGrid x:Name="CalcGrid" Grid.Row="1" Columns="4" Rows="5"/>
                    </Grid>

                    <!-- CALENDAR -->
                    <Grid x:Name="CalPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Button Style="{StaticResource Pill}" Background="Transparent" Width="32" Height="24" HorizontalAlignment="Left"
                                    FontFamily="Segoe MDL2 Assets" FontSize="11" Content="&#xE76B;" Click="CalPrev_Click"/>
                            <TextBlock x:Name="CalTitle" Text="Month" Foreground="White" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="CalTitle_Click"/>
                            <Button Style="{StaticResource Pill}" Background="Transparent" Width="32" Height="24" HorizontalAlignment="Right"
                                    FontFamily="Segoe MDL2 Assets" FontSize="11" Content="&#xE76C;" Click="CalNext_Click"/>
                        </Grid>
                        <UniformGrid x:Name="CalWeekdays" Grid.Row="1" Columns="7"/>
                        <UniformGrid x:Name="CalDays" Grid.Row="2" Columns="7" Rows="6"/>
                    </Grid>

                    <!-- WEATHER -->
                    <Grid x:Name="WeatherPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WIconBig" Text="&#x1F4CD;" FontFamily="Segoe UI Emoji" FontSize="40" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="WTempBig" Text="--" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="WCondBig" Text="No location set" Foreground="#D1D1D6" FontSize="14" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                                </StackPanel>
                                <TextBlock x:Name="WCityText" Text="Search your city below" Foreground="#8E8E93" FontSize="12"/>
                                <TextBlock x:Name="WDetail" Text="" Foreground="#8E8E93" FontSize="11" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button x:Name="WUnitBtn" Grid.Column="2" Style="{StaticResource Pill}" Width="44" Height="28" Content="°C" Click="Unit_Click" VerticalAlignment="Top"/>
                        </Grid>
                        <Border Grid.Row="1" Height="34" CornerRadius="17" Background="#1C1C1E" BorderBrush="#3A3A3C" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#x1F4CD;" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="CityBox" Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0"
                                             FontSize="12" VerticalContentAlignment="Center" Padding="8,0"
                                             PreviewKeyDown="City_KeyDown" TextChanged="City_TextChanged"
                                             LostKeyboardFocus="Input_LostFocus" PreviewMouseDown="Input_MouseDown"/>
                                    <TextBlock x:Name="CityHint" Text="Type your city to set the weather location…" Foreground="#636366" FontSize="12"
                                               VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                                <Button Grid.Column="2" Style="{StaticResource Pill}" Content="Search" Width="64" Margin="3" FontSize="12" Click="Search_Click"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ResultsList"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- ALERTS + COMMAND BOX -->
                    <Grid x:Name="AlertsPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AlertList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#D1D1D6" FontFamily="Consolas" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Grid.Row="1" Height="36" CornerRadius="18" Background="#1C1C1E" BorderBrush="#3A3A3C" BorderThickness="1" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&gt;_" Foreground="#30D158" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="14,0,4,0"/>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="CmdBox" Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0"
                                             FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" Padding="4,0"
                                             PreviewKeyDown="Cmd_KeyDown" TextChanged="Cmd_TextChanged"
                                             LostKeyboardFocus="Input_LostFocus" PreviewMouseDown="Input_MouseDown"/>
                                    <TextBlock x:Name="CmdHint" Text="Type a command, e.g. ipconfig, dir, ping google.com" Foreground="#636366"
                                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                </Grid>
                                <Button Grid.Column="2" Style="{StaticResource Pill}" Content="Clear" FontSize="11" Width="50" Margin="3" Click="ClearAlerts_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- VERSION / UPDATE -->
                    <Grid x:Name="VersionPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="/Assets/island.png" Width="46" Height="46" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="UpdTitle" Text="Checking for updates…" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,8,0,2"/>
                            <TextBlock x:Name="UpdDetail" Text="" Foreground="#8E8E93" FontSize="12" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="400" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                            <Button x:Name="InstallBtn" Style="{StaticResource InstallBtn}" Width="200" Height="40" IsEnabled="False"
                                    HorizontalAlignment="Center" Click="Install_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="InstallIcon" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InstallText" Text="Install update" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="UpdProgressHost" Height="4" CornerRadius="2" Background="#3A3A3C" Margin="40,10,40,0" Visibility="Collapsed">
                                <Border x:Name="UpdProgress" Background="#30D158" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                            </Border>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="CurVersion" Text="Current version 1.0.1" Foreground="#636366" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource Pill}" Background="Transparent" Foreground="#8E8E93" FontSize="11"
                                    Content="Check now" Width="80" Height="22" HorizontalAlignment="Right" Click="CheckNow_Click"/>
                        </Grid>
                    </Grid>

                    <!-- Footer: power button -->
                    <Grid Grid.Row="2" Height="34" Margin="0,8,0,0">
                        <Button x:Name="PowerBtn" Style="{StaticResource CircleBtn}" Background="#FF3B30" Width="32" Height="32"
                                HorizontalAlignment="Right" FontFamily="Segoe MDL2 Assets" FontSize="14" Content="&#xE7E8;" Click="PowerBtn_Click"/>
                    </Grid>
                </Grid>

                <!-- Notification / device popup card -->
                <Grid x:Name="NotifCard" Grid.Row="0" Grid.RowSpan="2" Opacity="0" IsHitTestVisible="False" Background="Transparent"
                      Margin="16,0" Cursor="Hand" MouseLeftButtonDown="NotifCard_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="12" Background="#2B2B2E" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="NotifEmoji" Text="&#x1F514;" FontFamily="Segoe UI Emoji" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="NotifIcon" Margin="5" Stretch="Uniform" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NotifApp" Text="App" Foreground="#8E8E93" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotifTitle" Text="Title" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotifBody" Text="Message" Foreground="#D1D1D6" FontSize="12" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- Power menu popover -->
                <Border x:Name="PowerMenu" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,52"
                        Background="#F21C1C1E" BorderBrush="#48484A" BorderThickness="1" CornerRadius="16" Padding="6">
                    <Grid>
                        <StackPanel x:Name="PowerList">
                            <Button Style="{StaticResource Pill}" Tag="exit"     Content="Exit island" Width="140" Height="32" Margin="0,2" Click="PowerOption_Click"/>
                            <Button x:Name="SleepBtn" Style="{StaticResource Pill}" Tag="sleep" Content="Sleep" Width="140" Height="32" Margin="0,2" Click="PowerOption_Click"/>
                            <Button Style="{StaticResource Pill}" Tag="restart"  Content="Restart"    Width="140" Height="32" Margin="0,2" Click="PowerOption_Click"/>
                            <Button Style="{StaticResource Pill}" Tag="shutdown" Content="Shut down"  Width="140" Height="32" Margin="0,2" Foreground="#FF6961" Click="PowerOption_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="PowerConfirm" Visibility="Collapsed" Width="140">
                            <TextBlock x:Name="ConfirmText" Text="Are you sure?" Foreground="White" FontSize="12" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="4,6,4,8"/>
                            <Button Style="{StaticResource Pill}" Content="Yes" Height="30" Margin="0,2" Background="#FF3B30" Click="PowerYes_Click"/>
                            <Button Style="{StaticResource Pill}" Content="Cancel" Height="30" Margin="0,2" Click="PowerCancel_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
