<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>IslandEye</RootNamespace>

    <!-- App identity: this is what Task Manager, the tray and Explorer show -->
    <AssemblyName>Island</AssemblyName>
    <AssemblyTitle>Island</AssemblyTitle>
    <Product>Island</Product>
    <Company>Island</Company>
    <Description>Island</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\island.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\island.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
